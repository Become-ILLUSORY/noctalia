# Maintainer: Become-ILLUSORY <becomeillusory@gmail.com>
#
# Noctalia with the immersive bar tint, built from the fork at
# github.com/Become-ILLUSORY/noctalia. Follows the Arch packaging guidelines and
# the style of the CachyOS PKGBUILDS tree.
#
# It keeps upstream's package name so it replaces extra/noctalia — which is what
# cachyos-niri-noctalia and friends depend on — and the pkgrel bump marks the
# fork. Installing it over the repo package is a normal upgrade, and
# `sudo pacman -S noctalia` afterwards restores the official build.
#
# Build with:
#   git clone https://github.com/Become-ILLUSORY/noctalia
#   cd noctalia/packaging/arch
#   makepkg -si

pkgname=noctalia
pkgver=5.2.1
# pkgrel must be plain integers (Arch rejects suffixes like "1.immersive").
# 2 is one above extra/noctalia's current 1, so `pacman -U` treats this as a
# normal upgrade instead of warning that the package is already up to date.
# When upstream ships a newer pkgver, pacman will upgrade to the official build
# and the immersive bar goes away until this package is rebuilt.
pkgrel=2
pkgdesc='A sleek, customizable desktop shell crafted for Wayland (immersive bar tint fork)'
arch=('x86_64' 'aarch64')
url="https://github.com/Become-ILLUSORY/noctalia"
license=('MIT')
depends=(
  bash cairo curl fontconfig freetype2 git glib2 glibc harfbuzz
  hicolor-icon-theme jemalloc libgcc libglvnd libical libjxl libpipewire
  libqalculate librsvg libsecret libsndfile libsodium libstdc++ libwebp
  libwireplumber libxkbcommon libxml2 md4c pam pango polkit sdbus-cpp
  tomlplusplus wayland
)
makedepends=(meson ninja nlohmann-json pkgconf stb wayland-protocols)
optdepends=(
  'ddcutil: monitor brightness control'
  'power-profiles-daemon: power profile management'
  'upower: battery and power device integration'
)
# Same name as extra/noctalia, so pacman swaps between the two instead of
# reporting a file conflict: this is a drop-in replacement.
provides=('noctalia')
conflicts=('noctalia')

# No remote source: this packages the working tree it lives in, which is what
# makes `makepkg` work identically from a local clone and from CI without
# pinning a checksum for a tag that has to exist first. prepare() stages that
# tree into $srcdir so build() runs in a clean copy.
source=()
sha512sums=()

_srcname="${pkgname}-${pkgver}-immersive"

prepare() {
  local repo_root
  repo_root="$(realpath "${startdir}/../..")"

  rm -rf "${srcdir}/${_srcname}"
  mkdir -p "${srcdir}/${_srcname}"
  tar -C "${repo_root}" \
    --exclude='.git' \
    --exclude='build' \
    --exclude='build-*' \
    --exclude='*.pkg.tar.zst' \
    -cf - . | tar -C "${srcdir}/${_srcname}" -xf -
}

build() {
  cd "${srcdir}/${_srcname}"

  # Release build with tests off: PACKAGING.md directs packagers to leave them
  # disabled, and CI already runs the debug build with the full test suite.
  # -Dnative_optimizations stays off so the package is portable.
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    --strip \
    -Dcpp_std=c++23 \
    -Dtests=disabled \
    -Djemalloc=enabled
  meson compile -C build
}

check() {
  cd "${srcdir}/${_srcname}"

  # Smoke tests that need no compositor: the binary runs and can emit the
  # completion scripts installed below.
  ./build/noctalia --version > /dev/null
  ./build/noctalia completions bash > /dev/null
}

package() {
  cd "${srcdir}/${_srcname}"

  meson install -C build --destdir "${pkgdir}"

  # Completions are generated from the built binary rather than installed by
  # Meson, so cross-compilation is not broken (PACKAGING.md). Written into
  # ${srcdir} first because redirecting straight into ${pkgdir} trips makepkg's
  # ownership checks.
  ./build/noctalia completions bash > "${srcdir}/noctalia.bash"
  ./build/noctalia completions zsh > "${srcdir}/_noctalia"
  ./build/noctalia completions fish > "${srcdir}/noctalia.fish"
  install -Dm644 "${srcdir}/noctalia.bash" "${pkgdir}/usr/share/bash-completion/completions/noctalia"
  install -Dm644 "${srcdir}/_noctalia" "${pkgdir}/usr/share/zsh/site-functions/_noctalia"
  install -Dm644 "${srcdir}/noctalia.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/noctalia.fish"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
